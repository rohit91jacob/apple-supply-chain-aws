# Copy to .env (git-ignored). Every value is optional; defaults work offline-first.

# Where raw downloads, the Iceberg warehouse and DuckDB live (keep outside the repo for real runs)
ASC_DATA_DIR=data

# live = download from the public sources; fixtures = offline (tests/fixtures + SYNTHETIC files)
ASC_SOURCE_MODE=live
# ASC_FIXTURES_DIR=data/fixtures

# SEC asks for a descriptive User-Agent with a contact address: "Name contact@example.com"
SEC_USER_AGENT=apple-supply-chain-aws admin@example.com

# UN Comtrade public preview (keyless): years and reporter / HS codes to pull
ASC_TRADE_YEARS=2015-2024
# ASC_TRADE_REPORTERS=156,699,704,344,490,458,764,484,842,410,392
# ASC_TRADE_COMMODITIES=8517,8471,851712,851713

# Optional, key-gated source: US Census international trade API (skipped when empty)
CENSUS_API_KEY=

# Storage: local directories (default) or S3 via boto3 (moto, LocalStack or AWS)
ASC_STORE=local
ASC_RAW_BUCKET=asc-raw
ASC_CURATED_BUCKET=asc-curated
# AWS_ENDPOINT_URL=http://localhost:4566   # LocalStack

# Iceberg catalog: sql (SQLite stand-in for Glue) or glue
ASC_CATALOG=sql

# text or json logs
ASC_LOG_FORMAT=text
